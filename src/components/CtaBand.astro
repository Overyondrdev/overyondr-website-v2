---
import Img from './Img.astro';
import Icon from './Icon.astro';
---

<section class="cta-band surface-forest" aria-labelledby="cta-title">
  <div class="cta-card surface-lime">
    <div class="cta-copy">
      <h2 id="cta-title" class="h1" data-split>
        Ready To Go Phone-Free?
      </h2>
      <p class="lead">
        Whether you’re shaping a school day, producing a live event, or building more intentional habits,
        Yondr can help.
      </p>
      <div class="flow-row">
        <a href="/get-started" class="btn btn-dark">
          Talk To Us <Icon name="arrow-right" class="btn-icon" />
        </a>
        <a href="/how-it-works" class="link-arrow">
          See how it works <Icon name="arrow-right" />
        </a>
      </div>
    </div>
    <div class="cta-media" aria-hidden="true">
      <div class="cta-photo">
        <Img src="picnic.jpg" alt="" sizes="(min-width: 900px) 40vw, 100vw" />
      </div>
      <div class="cta-pouch">
        <Img src="product-pouch.png" alt="" sizes="16rem" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-top: 0;
  }
  .cta-card {
    position: relative;
    display: grid;
    border-radius: 0 0 0 var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .cta-card {
      grid-template-columns: 1.35fr 1fr;
      min-height: 34rem;
    }
  }
  .cta-copy {
    display: grid;
    align-content: center;
    gap: 1.5rem;
    padding: clamp(3rem, 7vw, 6rem) var(--gutter);
    padding-left: max(var(--gutter), (100vw - var(--max)) / 2);
  }
  .cta-copy .lead {
    max-width: 40ch;
  }
  .cta-media {
    position: relative;
    min-height: 22rem;
  }
  .cta-photo {
    position: absolute;
    inset: 0;
  }
  .cta-photo :global(picture),
  .cta-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta-pouch {
    position: absolute;
    left: clamp(-7rem, -7vw, -4rem);
    bottom: -1.5rem;
    width: clamp(9rem, 15vw, 14rem);
    filter: drop-shadow(0 30px 30px rgb(0 0 0 / 0.35));
    rotate: -4deg;
    transition:
      rotate 0.8s var(--ease-out),
      translate 0.8s var(--ease-out);
  }
  .cta-card:hover .cta-pouch {
    rotate: 2deg;
    translate: 0 -10px;
  }
  @media (max-width: 899px) {
    .cta-pouch {
      left: 1.5rem;
      bottom: 1rem;
      width: 8rem;
    }
  }
</style>
