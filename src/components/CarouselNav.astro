---
import Icon from './Icon.astro';
interface Props {
  label: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---

<div class:list={['carousel-nav', className]}>
  <button class="icon-btn" type="button" data-prev aria-label={`Previous ${label}`}>
    <Icon name="arrow-left" />
  </button>
  <button class="icon-btn" type="button" data-next aria-label={`Next ${label}`}>
    <Icon name="arrow-right" />
  </button>
</div>

<style>
  .carousel-nav {
    display: flex;
    gap: 0.6rem;
  }
</style>
