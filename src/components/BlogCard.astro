---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { formatDate, type Post } from '../lib/blog';

interface Props {
  post: Post;
  /** "stack": image over a lime caption (used in 3-up teasers). "plain": image + text on the page background. */
  variant?: 'stack' | 'flip' | 'plain';
  sizes?: string;
}
const { post, variant = 'plain', sizes = '(min-width: 900px) 30vw, 90vw' } = Astro.props;
const { title, description, image, imageAlt, date, category } = post.data;
---

<article data-tilt="4" class:list={['blog-card', `bc-${variant}`]}>
  <div class="bc-media media">
    <Picture
      src={image}
      alt={imageAlt}
      formats={['webp']}
      widths={[480, 800, 1200]}
      sizes={sizes}
      loading="lazy"
    />
  </div>
  <div class="bc-body">
    <p class="bc-meta">
      {category} · <time datetime={date.toISOString()}>{formatDate(date, 'short')}</time>
    </p>
    <h3>
      <a href={`/blog/${post.id}`} class="card-link">
        {title}
      </a>
    </h3>
    <p class="bc-desc">{description}</p>
    <span class="link-arrow" aria-hidden="true">
      Read More <Icon name="arrow-right" />
    </span>
  </div>
</article>

<style>
  .blog-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.5s var(--ease-out);
  }
  .bc-media {
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  .blog-card:hover .bc-media :global(img) {
    transform: scale(1.05);
  }
  .bc-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem 1.25rem 1.4rem;
  }
  .bc-meta {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0.75;
  }
  h3 {
    font-size: var(--step-1);
  }
  h3 a {
    text-decoration: none;
  }
  .bc-desc {
    font-size: 0.92rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bc-stack .bc-body,
  .bc-flip .bc-body {
    background: var(--lime);
    color: var(--forest);
  }
  .bc-flip {
    flex-direction: column-reverse;
  }
  .bc-plain {
    border-radius: 0;
    overflow: visible;
  }
  .bc-plain .bc-media {
    border-radius: var(--radius);
  }
  .bc-plain .bc-body {
    padding-inline: 0;
  }
</style>
