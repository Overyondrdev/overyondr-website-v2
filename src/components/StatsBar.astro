---
export interface Stat {
  value: number;
  decimals?: number;
  prefix?: string;
  suffix?: string;
  /** Text to show instead of an animated number, e.g. "50-80%". */
  display?: string;
  label: string;
}
interface Props {
  stats: Stat[];
  layout?: 'inline' | 'stacked';
  class?: string;
}
const { stats, layout = 'inline', class: className } = Astro.props;
const fmt = (s: Stat) => s.display ?? `${s.prefix ?? ''}${s.value.toFixed(s.decimals ?? 0)}${s.suffix ?? ''}`;
---

<dl class:list={['stats', `stats-${layout}`, className]} data-items={stats.length} data-reveal>
  {stats.map((s) => (
    <div class="stat">
      <dt class="stat-label">{s.label}</dt>
      <dd class="stat-value">
        {s.display ? (
          s.display
        ) : (
          <span
            data-count={s.value}
            data-decimals={s.decimals ?? 0}
            data-prefix={s.prefix ?? ''}
            data-suffix={s.suffix ?? ''}
          >
            {fmt(s)}
          </span>
        )}
      </dd>
    </div>
  ))}
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.25rem, 3vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--forest);
    color: var(--cream);
    box-shadow: 0 30px 60px -40px rgb(20 24 17 / 0.6);
  }
  .stat {
    /* Each cell is a size container so the number can never be wider than its cell. */
    container-type: inline-size;
    min-width: 0;
    display: flex;
    flex-direction: row-reverse;
    justify-content: center;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem clamp(0.75rem, 2vw, 1.5rem);
  }
  .stat + .stat {
    border-left: 1px solid rgb(220 255 107 / 0.35);
  }
  .stat-value {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--lime);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .stat-label {
    font-weight: 600;
    line-height: 1.2;
    max-width: 11ch;
    font-size: var(--step-0);
  }
  .stats-stacked .stat {
    flex-direction: column-reverse;
    /* Values share a top line across the row; one- and two-line labels hang below them. */
    justify-content: flex-end;
    text-align: center;
    gap: 0.6rem;
  }
  .stats-stacked .stat-label {
    max-width: 22ch;
  }
  /* Stacked values are words as well as numbers ("26 States"): scale them to the cell. */
  .stats-stacked .stat-value {
    font-size: min(var(--step-4), 21cqi);
  }
  /* Four stats on a tablet: two rows of two instead of three and an orphan. */
  @media (min-width: 701px) and (max-width: 999px) {
    .stats[data-items='4'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats[data-items='4'] .stat:nth-child(odd) {
      border-left: 0;
    }
    .stats[data-items='4'] .stat:nth-child(n + 3) {
      border-top: 1px solid rgb(220 255 107 / 0.25);
    }
  }
  @media (max-width: 700px) {
    .stat + .stat {
      border-left: 0;
      border-top: 1px solid rgb(220 255 107 / 0.25);
    }
    .stat {
      justify-content: flex-end;
    }
    .stats-inline .stat {
      justify-content: space-between;
    }
    /* Labels start on one shared edge, however wide the number beside them. */
    .stats-inline .stat-label {
      flex: 0 1 11ch;
    }
  }
</style>
