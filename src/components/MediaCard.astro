---
// Photo card with gradient, title, excerpt and a "Read More" pill. Used for press features and resources.
import Img from './Img.astro';
import Icon from './Icon.astro';

interface Props {
  image: string;
  alt?: string;
  title: string;
  text?: string;
  href?: string;
  cta?: string;
  external?: boolean;
  class?: string;
  sizes?: string;
}
const {
  image,
  alt = '',
  title,
  text,
  href,
  cta = 'Read More',
  external = true,
  class: className,
  sizes = '(min-width: 900px) 50vw, 100vw',
} = Astro.props;
---

<article class:list={['media-card card', className]}>
  <div class="media-card-img">
    <Img src={image} alt={alt} sizes={sizes} />
  </div>
  <div class="media-card-body">
    <div>
      <h3>{title}</h3>
      {text && <p>{text}</p>}
    </div>
    {href && (
      <a
        class="btn btn-sm"
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener' : undefined}
      >
        {cta} <Icon name={external ? 'external' : 'arrow-right'} class="btn-icon" />
        {external && <span class="visually-hidden">(opens in a new tab)</span>}
      </a>
    )}
  </div>
</article>

<style>
  .media-card {
    min-height: 12rem;
    justify-content: flex-end;
    background: var(--charcoal);
    color: var(--white);
    isolation: isolate;
  }
  .media-card-img {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .media-card-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .media-card:hover .media-card-img :global(img) {
    transform: scale(1.05);
  }
  .media-card-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(10 12 8 / 0.9), rgb(10 12 8 / 0.35) 55%, rgb(10 12 8 / 0.05));
  }
  .media-card-body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.1rem, 2vw, 1.5rem);
  }
  .media-card-body > div {
    flex: 1 1 16rem;
  }
  .media-card h3 {
    font-size: var(--step-2);
  }
  .media-card p {
    margin-top: 0.35rem;
    font-size: 0.92rem;
    max-width: 48ch;
    color: rgb(255 255 255 / 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .media-card .btn::after {
    background: var(--cream);
  }
  .media-card .btn:hover {
    color: var(--forest);
  }
</style>
