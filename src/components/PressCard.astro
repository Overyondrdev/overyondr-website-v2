---
import Icon from './Icon.astro';
import type { PressItem } from '../data/press';

interface Props {
  item: PressItem;
  showDate?: boolean;
  class?: string;
}
const { item, showDate = false, class: className } = Astro.props;
const isPdf = item.url?.endsWith('.pdf');
const date = new Date(item.date + 'T12:00:00').toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
});
const Tag = item.url ? 'a' : 'div';
---

<Tag
  data-tilt="5"
  class:list={['press-card card', className]}
  href={item.url}
  target={item.url && !item.url.startsWith('/') ? '_blank' : undefined}
  rel={item.url && !item.url.startsWith('/') ? 'noopener' : undefined}
>
  <p class="press-outlet">{item.outlet}</p>
  {showDate && <p class="press-date">{date}</p>}
  <p class="press-text">{item.title ?? item.excerpt}</p>
  {item.url && (
    <span class="press-icon" aria-hidden="true">
      <Icon name={isPdf ? 'download' : 'arrow-up-right'} size={18} />
    </span>
  )}
  {item.url && <span class="visually-hidden">(opens {isPdf ? 'PDF' : 'in a new tab'})</span>}
</Tag>

<style>
  .press-card {
    min-height: 11rem;
    padding: 1.25rem 1.25rem 3.75rem;
    text-decoration: none;
    gap: 0.4rem;
  }
  .press-outlet {
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .press-date {
    font-size: 0.82rem;
    color: #5b6152;
  }
  .press-text {
    font-size: 0.92rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .press-icon {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--lime);
    color: var(--forest);
    transition:
      transform 0.4s var(--ease-out),
      background 0.3s,
      color 0.3s;
  }
  .press-card:hover .press-icon {
    transform: rotate(45deg) scale(1.08);
    background: var(--forest);
    color: var(--lime);
  }
</style>
