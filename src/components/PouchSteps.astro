---
// "About The Pouch": three illustrated steps (inline SVG, animated on hover / when in view).
---

<ol class="pouch-steps">
  <li data-reveal style="--i:0">
    <div class="ps-tile">
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <g class="ps-phone">
          <rect
            x="74"
            y="22"
            width="52"
            height="92"
            rx="9"
            fill="#fff"
            stroke="#141811"
            stroke-width="3"
          ></rect>
          <rect x="80" y="30" width="40" height="70" rx="4" fill="#141811" opacity=".12"></rect>
        </g>
        <path
          d="M58 92h84v74a14 14 0 0 1-14 14H72a14 14 0 0 1-14-14z"
          fill="#fff"
          stroke="#141811"
          stroke-width="3"
        ></path>
        <path d="M66 100v72M134 100v72" stroke="#141811" stroke-width="2" stroke-dasharray="4 5"></path>
        <path
          d="M100 52v26m-9-9 9 9 9-9"
          class="ps-arrow"
          stroke="#dcff6b"
          stroke-width="4"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </div>
    <p>
      <span>1</span> Power off your device and place it inside the pouch
    </p>
  </li>
  <li data-reveal style="--i:1">
    <div class="ps-tile">
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <path
          d="M58 40a42 42 0 0 1 84 0v126a14 14 0 0 1-14 14H72a14 14 0 0 1-14-14z"
          fill="#fff"
          stroke="#141811"
          stroke-width="3"
        ></path>
        <path d="M66 52v118M134 52v118" stroke="#141811" stroke-width="2" stroke-dasharray="4 5"></path>
        <circle cx="100" cy="62" r="13" fill="#141811"></circle>
        <circle class="ps-button" cx="100" cy="62" r="8" fill="#dcff6b"></circle>
        <g class="ps-click" stroke="#dcff6b" stroke-width="4" stroke-linecap="round">
          <path d="M100 26v-10M126 36l7-7M74 36l-7-7"></path>
        </g>
      </svg>
    </div>
    <p>
      <span>2</span> Push the green button to secure your pouch
    </p>
  </li>
  <li data-reveal style="--i:2">
    <div class="ps-tile">
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <ellipse cx="100" cy="162" rx="70" ry="18" fill="#fff" stroke="#141811" stroke-width="3"></ellipse>
        <path
          d="M30 162v12c0 10 31 18 70 18s70-8 70-18v-12"
          fill="#fff"
          stroke="#141811"
          stroke-width="3"
        ></path>
        <ellipse cx="100" cy="158" rx="20" ry="6" fill="#141811"></ellipse>
        <g class="ps-tap">
          <path
            d="M84 24a26 26 0 0 1 52 0v88a10 10 0 0 1-10 10H94a10 10 0 0 1-10-10z"
            fill="#fff"
            stroke="#141811"
            stroke-width="3"
          ></path>
          <circle cx="110" cy="38" r="8" fill="none" stroke="#dcff6b" stroke-width="4"></circle>
        </g>
      </svg>
    </div>
    <p>
      <span>3</span> Tap the green ring to the base to open the pouch
    </p>
  </li>
</ol>

<style>
  .pouch-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    list-style: none;
    padding: 0;
    counter-reset: s;
  }
  .ps-tile {
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    background: var(--charcoal);
    box-shadow:
      inset 0 0 0 3px var(--charcoal),
      inset 0 0 0 5px #fff;
    display: grid;
    place-items: center;
    overflow: hidden;
    transition: transform 0.5s var(--ease-out);
  }
  li:hover .ps-tile {
    transform: translateY(-6px) rotate(-1deg);
  }
  .ps-tile svg {
    width: 82%;
  }
  .pouch-steps p {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-top: 1.25rem;
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .pouch-steps p span {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--forest);
    color: var(--lime);
    font-size: 0.9rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ps-phone {
      animation: drop 3.2s var(--ease-in-out) infinite;
    }
    .ps-arrow {
      animation: blink 3.2s infinite;
    }
    .ps-button {
      transform-origin: 100px 62px;
      animation: press 2.4s var(--ease-out) infinite;
    }
    .ps-click {
      animation: blink 2.4s infinite;
    }
    .ps-tap {
      transform-origin: 110px 120px;
      animation: tap 3s var(--ease-in-out) infinite;
    }
    @keyframes drop {
      0%,
      15% {
        transform: translateY(-14px);
      }
      55%,
      100% {
        transform: translateY(46px);
      }
    }
    @keyframes blink {
      0%,
      30% {
        opacity: 1;
      }
      50%,
      100% {
        opacity: 0;
      }
    }
    @keyframes press {
      0%,
      20% {
        transform: scale(1);
      }
      35% {
        transform: scale(0.7);
      }
      55%,
      100% {
        transform: scale(1);
      }
    }
    @keyframes tap {
      0%,
      20% {
        transform: translateY(-6px) rotate(-8deg);
      }
      50% {
        transform: translateY(14px) rotate(0);
      }
      70%,
      100% {
        transform: translateY(-6px) rotate(-8deg);
      }
    }
  }
</style>
