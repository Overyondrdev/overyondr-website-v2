---
import PressCard from './PressCard.astro';
import MediaCard from './MediaCard.astro';
import Img from './Img.astro';
import Icon from './Icon.astro';
import { pressHighlights as p, featured } from '../data/press';

interface Props {
  variant?: 'default' | 'spotlight';
  title?: string;
  text?: string;
  surface?: string;
}
const {
  variant = 'default',
  title = variant === 'spotlight' ? 'Media Spotlight' : 'Press',
  text = 'Yondr has been recognized by major media outlets as the pioneer and creator of phone-free spaces. Explore articles to learn more about our industry expertise and real-world impact.',
  surface = 'surface-cream',
} = Astro.props;
const [cnn, forbes, vox, wsj] = p.cards;
---

<section class:list={['section press', surface]} aria-labelledby={`press-${variant}`}>
  <div class:list={['container bento', `bento-${variant}`]}>
    <div class="bento-head" data-reveal>
      <h2 id={`press-${variant}`} class="h2" data-split>
        {title}
      </h2>
      <p>{text}</p>
      <a href="/press" class="btn">
        View All Press <Icon name="arrow-right" class="btn-icon" />
      </a>
    </div>

    {variant === 'default' ? (
      <>
        <MediaCard
          class="b-feature"
          image="press-wapo.jpg"
          title={p.feature.outlet}
          text={p.feature.excerpt}
          href={p.feature.url}
        />
        <PressCard class="b-c1" item={cnn} />
        <PressCard class="b-c2" item={forbes} />
        <MediaCard
          class="b-wide"
          image="lockers-colour.jpg"
          title={p.chronicle.outlet}
          text={p.chronicle.excerpt}
          href={p.chronicle.url}
          sizes="(min-width: 900px) 45vw, 100vw"
        />
        <PressCard class="b-c3" item={vox} />
        <PressCard class="b-c4" item={wsj} />
      </>
    ) : (
      <>
        <MediaCard
          class="b-bar"
          image="bar-lamp.jpg"
          title={p.bar.outlet}
          text={p.bar.excerpt}
          href={p.bar.url}
          sizes="(min-width: 900px) 45vw, 100vw"
        />
        <PressCard class="b-c1" item={cnn} />
        <PressCard class="b-c2" item={forbes} />
        <article class="podcast card b-pod">
          <div class="pod-art">
            <Img
              src="kara-swisher.jpg"
              alt="On with Kara Swisher podcast artwork"
              sizes="(min-width: 900px) 22vw, 50vw"
            />
          </div>
          <div class="pod-body">
            <p class="pod-show">{featured.podcast.show}</p>
            <h3>{featured.podcast.title}</h3>
            <p class="pod-text">{featured.podcast.excerpt}</p>
            <a class="pod-play card-link" href={featured.podcast.url} target="_blank" rel="noopener">
              <span class="pod-btn">
                <Icon name="play" size={20} />
              </span>
              <span class="pod-track" aria-hidden="true">
                <span />
              </span>
              <span class="pod-time">{featured.podcast.duration}</span>
              <span class="visually-hidden">Listen on Spotify (opens in a new tab)</span>
            </a>
          </div>
        </article>
        <MediaCard
          class="b-wide"
          image="lockers-colour.jpg"
          title={p.chronicle.outlet}
          text={p.chronicle.excerpt}
          href={p.chronicle.url}
          sizes="(min-width: 900px) 45vw, 100vw"
        />
      </>
    )}
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .bento > :global(*) {
    grid-column: span 2;
  }
  .bento-head {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    justify-items: start;
    padding-bottom: 1rem;
  }
  .bento-head p {
    max-width: 46ch;
  }
  @media (min-width: 560px) {
    .bento :global(.b-c1),
    .bento :global(.b-c2),
    .bento :global(.b-c3),
    .bento :global(.b-c4) {
      grid-column: span 1;
    }
  }
  @media (min-width: 1000px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .bento-head {
      grid-column: 1 / 3;
    }
    .bento-default :global(.b-feature) {
      grid-column: 3 / 5;
      grid-row: 1 / 3;
      min-height: 28rem;
    }
    .bento-default :global(.b-c1) {
      grid-column: 1;
      grid-row: 2;
    }
    .bento-default :global(.b-c2) {
      grid-column: 2;
      grid-row: 2;
    }
    .bento-default :global(.b-wide) {
      grid-column: 1 / 3;
      grid-row: 3;
    }
    .bento-default :global(.b-c3) {
      grid-column: 3;
      grid-row: 3;
    }
    .bento-default :global(.b-c4) {
      grid-column: 4;
      grid-row: 3;
    }

    .bento-spotlight :global(.b-bar) {
      grid-column: 3 / 5;
      grid-row: 1;
    }
    .bento-spotlight :global(.b-c1) {
      grid-column: 1;
      grid-row: 2;
    }
    .bento-spotlight :global(.b-c2) {
      grid-column: 2;
      grid-row: 2;
    }
    .bento-spotlight :global(.b-pod) {
      grid-column: 3 / 5;
      grid-row: 2 / 4;
    }
    .bento-spotlight :global(.b-wide) {
      grid-column: 1 / 3;
      grid-row: 3;
    }
  }

  .podcast {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
  }
  .pod-art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pod-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
  }
  .pod-show {
    font-size: 0.85rem;
    color: #5b6152;
  }
  .podcast h3 {
    font-size: var(--step-1);
  }
  .pod-text {
    font-size: 0.9rem;
  }
  .pod-play {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    text-decoration: none;
  }
  .pod-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--forest);
    color: var(--lime);
    transition: transform 0.3s var(--ease-out);
  }
  .podcast:hover .pod-btn {
    transform: scale(1.08);
  }
  .pod-track {
    position: relative;
    flex: 1;
    height: 3px;
    border-radius: 3px;
    background: #d9dccf;
    overflow: hidden;
  }
  .pod-track span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: var(--forest);
    transition: width 1.4s var(--ease-out);
  }
  .podcast:hover .pod-track span {
    width: 35%;
  }
  .pod-time {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 560px) {
    .podcast {
      grid-template-columns: 1fr;
    }
    .pod-art {
      aspect-ratio: 1;
    }
  }
</style>
