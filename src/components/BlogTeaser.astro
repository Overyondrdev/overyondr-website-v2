---
import BlogCard from './BlogCard.astro';
import Icon from './Icon.astro';
import { getPosts } from '../lib/blog';

interface Props {
  title?: string;
  text?: string;
  exclude?: string;
  surface?: string;
}
const {
  title = 'Blog',
  text = 'Discover educational articles, explore research, and stay up to date with how Yondr is leading the phone-free movement.',
  exclude,
  surface = 'surface-cream',
} = Astro.props;
const posts = (await getPosts()).filter((p) => p.id !== exclude).slice(0, 3);
---

<section class:list={['section', surface]} aria-labelledby="blog-teaser">
  <div class="container">
    <div class="teaser-grid">
      {posts.map((p, i) => (
        <div data-reveal style={`--i:${i}`}>
          <BlogCard post={p} variant={i === 1 ? 'flip' : 'stack'} />
        </div>
      ))}
    </div>
    <div class="teaser-foot">
      <div>
        <h2 id="blog-teaser" class="h2" data-split>
          {title}
        </h2>
        <p>{text}</p>
      </div>
      <a href="/blog" class="btn">
        Discover More <Icon name="arrow-right" class="btn-icon" />
      </a>
    </div>
  </div>
</section>

<style>
  .teaser-grid {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }
  @media (min-width: 800px) {
    .teaser-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .teaser-grid > :nth-child(2) {
      margin-top: 3rem;
    }
  }
  .teaser-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .teaser-foot p {
    margin-top: 1rem;
    max-width: 50ch;
  }
</style>
