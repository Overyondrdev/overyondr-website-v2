---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Show the "Ready to go phone-free?" band above the footer (default true). */
  cta?: boolean;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const {
  title,
  description,
  image = '/og-default.jpg',
  cta = true,
  schema = [],
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === site.name ? `${site.name}: Phone-Free Spaces` : `${title} | ${site.name}`;
const ogImage = new URL(image, Astro.site);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Yondr',
  legalName: 'Yondr, Inc.',
  url: site.url,
  logo: new URL('/favicon.svg', Astro.site).href,
  email: site.email,
  sameAs: [site.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1c2b0e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify([orgSchema, ...schema])} />
    <!-- Analytics: add the LinkedIn Insight Tag (partner 6989514) at parity sign-off. -->
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {cta && <CtaBand />}
    <Footer />
    <button class="to-top" type="button" data-to-top aria-label="Back to top">
      <svg class="ring" viewBox="0 0 52 52" aria-hidden="true">
        <circle cx="26" cy="26" r="24"></circle>
      </svg>
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
    </button>
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
