---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogTeaser from '../../components/BlogTeaser.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, formatDate, readingTime, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const mins = readingTime(post.body);
const url = new URL(`/blog/${post.id}`, Astro.site).href;
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  url,
  publisher: { '@type': 'Organization', name: 'Yondr' },
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={post.data.image.src}
  schema={[article]}
>
  <div class="read-progress" aria-hidden="true">
    <span data-progress></span>
  </div>

  <header class="post-hero">
    <div class="ph-media">
      <Picture
        src={post.data.image}
        alt={post.data.imageAlt}
        formats={['webp']}
        widths={[800, 1400, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container ph-inner">
      <a href="/blog" class="ph-back">
        <Icon name="arrow-left" size={18} /> All articles
      </a>
      <p class="ph-meta">
        <span class="ph-cat">{post.data.category}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>
          <Icon name="clock" size={16} /> {mins} min read
        </span>
      </p>
      <h1 class="h1 text-accent" data-split>
        {post.data.title}
      </h1>
    </div>
  </header>

  <div class="section surface-cream">
    <div class="container post-layout">
      <aside class="post-aside">
        {toc.length > 1 && (
          <nav aria-label="In this article" class="post-toc">
            <p>In this article</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        <div class="share">
          <p>Share</p>
          <div>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`}
              target="_blank"
              rel="noopener"
              class="icon-btn"
              aria-label="Share on LinkedIn (opens in a new tab)"
            >
              <Icon name="linkedin" />
            </a>
            <a
              href={`mailto:?subject=${encodeURIComponent(post.data.title)}&body=${encodeURIComponent(url)}`}
              class="icon-btn"
              aria-label="Share by email"
            >
              <Icon name="mail" />
            </a>
            <button type="button" class="icon-btn" data-copy={url} aria-label="Copy link">
              <Icon name="external" />
            </button>
          </div>
          <p class="copied" role="status" aria-live="polite"></p>
        </div>
      </aside>
      <article class="prose post-body" data-article>
        <Content />
      </article>
    </div>
  </div>

  <BlogTeaser
    title="Related Articles"
    text="More stories and research from the phone-free movement."
    exclude={post.id}
    surface="surface-cream related"
  />
</Base>

<style>
  .read-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 70;
    height: 3px;
  }
  .read-progress span {
    display: block;
    height: 100%;
    background: var(--lime);
    transform-origin: left;
    transform: scaleX(0);
  }
  .post-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: min(78svh, 44rem);
    padding: calc(var(--header-h) + 4rem) 0 clamp(2.5rem, 5vw, 4rem);
    color: var(--white);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    overflow: hidden;
  }
  .ph-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  /* <Img> wraps the image in <picture>: let it fill the frame so the cover image reaches every edge. */
  .ph-media :global(picture) {
    height: 100%;
  }
  .ph-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ph-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(10 12 8 / 0.95), rgb(10 12 8 / 0.3) 60%, rgb(10 12 8 / 0.45));
  }
  .ph-inner {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .ph-inner h1 {
    font-size: clamp(2.2rem, 1.6rem + 2.6vw, 4rem);
    max-width: 26ch;
  }
  .ph-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    text-decoration: none;
  }
  .ph-back:hover {
    color: var(--lime);
  }
  .ph-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .ph-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .ph-cat {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--lime);
    color: var(--forest);
  }
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
  .post-layout > * {
    min-width: 0;
  }
  @media (min-width: 1000px) {
    .post-layout {
      grid-template-columns: 15rem minmax(0, 44rem);
      gap: 5rem;
      justify-content: center;
    }
    .post-aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
      order: 0;
    }
  }
  .post-toc p,
  .share > p:first-child {
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .post-toc ol {
    list-style: none;
    padding: 0;
    border-left: 2px solid var(--line);
  }
  .post-toc a {
    display: block;
    padding: 0.45rem 0.9rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-size: 0.92rem;
    line-height: 1.35;
    text-decoration: none;
  }
  .post-toc a[aria-current='true'],
  .post-toc a:hover {
    border-color: var(--forest);
    font-weight: 600;
  }
  .share {
    margin-top: 2rem;
  }
  .share > div {
    display: flex;
    gap: 0.5rem;
  }
  .copied {
    min-height: 1.2em;
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }
  .post-body {
    font-size: 1.08rem;
    line-height: 1.7;
  }
  .post-lede {
    font-size: var(--step-1);
    line-height: 1.5;
    font-weight: 500;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .post-body :global(h2) {
    font-size: var(--step-3);
  }
  .post-body :global(blockquote) {
    position: relative;
    margin-block: 2.5rem;
    padding: 1.75rem 1.75rem 1.75rem 4.5rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--forest);
    color: var(--cream);
  }
  .post-body :global(blockquote)::before {
    content: '“';
    position: absolute;
    left: 1.25rem;
    top: 0.5rem;
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 1;
    color: var(--lime);
  }
  .post-body :global(blockquote p) {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .post-body :global(ul li::marker) {
    color: var(--forest);
  }
  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
  }
  .post-body :global(th),
  .post-body :global(td) {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  :global(.related) {
    border-top: 1px solid var(--line);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('[data-article]');
  if (bar && article) {
    const onScroll = () => {
      const r = article.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', () => requestAnimationFrame(onScroll), { passive: true });
    onScroll();
  }
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  if (links.length) {
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (e.isIntersecting)
            links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.toc === e.target.id)));
        }),
      { rootMargin: '-20% 0px -70% 0px' },
    );
    links.forEach((l) => {
      const h = document.getElementById(l.dataset.toc!);
      if (h) io.observe(h);
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.closest('.share')!.querySelector('.copied')!.textContent = 'Link copied';
      } catch {
        /* clipboard unavailable */
      }
    }),
  );
</script>
