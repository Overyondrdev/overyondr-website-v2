---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import { milestones } from '../data/timeline';
---

<Base
  title="Our Story: A Timeline"
  description="From the first telephone to phone-free schools: how our relationship with technology has changed, and how Yondr is building a better way forward."
>
  <section class="tl-hero surface-cream">
    <div class="container tl-hero-grid">
      <div class="tl-hero-copy">
        <h1 class="h-hero tl-title" data-split>
          Timeline
        </h1>
        <p class="lead">
          Our relationship with technology is constantly evolving. As we push towards the future, looking back
          at the past shows us how to build a better way forward.
        </p>
        <a href="#timeline" class="link-arrow">
          Scroll <Icon name="arrow-right" />
        </a>
      </div>
      <div class="tl-collage" aria-hidden="true">
        <div class="c1">
          <Img src="tl-green-phone.jpg" alt="" sizes="20vw" priority />
        </div>
        <div class="c2">
          <Img src="tl-nokias.jpg" alt="" sizes="20vw" priority />
        </div>
        <div class="c3"></div>
      </div>
    </div>
  </section>

  <section class="tl surface-charcoal" id="timeline" aria-label="Timeline" data-hscroll>
    <div class="tl-sticky">
      <div class="tl-progress" aria-hidden="true">
        <span></span>
      </div>
      <ol class="tl-track" data-hscroll-track>
        {milestones.map((m, i) => (
          <li class:list={['tl-item', `tl-${m.kind}`]} style={`--i:${i}`}>
            {m.image && (
              <div class="tl-img">
                <Img
                  src={m.image}
                  alt={m.alt ?? ''}
                  sizes="(min-width: 900px) 26rem, 85vw"
                  widths={[480, 800, 1200]}
                />
              </div>
            )}
            <div class="tl-text">
              <p class="tl-year">{m.year}</p>
              <h2 class="tl-h">{m.title}</h2>
              <p>{m.text}</p>
              {m.source && <p class="tl-source">Source: {m.source}</p>}
            </div>
          </li>
        ))}
        <li class="tl-item tl-end">
          <div class="tl-text">
            <p class="tl-year">Next</p>
            <h2 class="tl-h h2">Off we go.</h2>
            <a href="/get-started" class="btn">
              Get Started <Icon name="arrow-right" class="btn-icon" />
            </a>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="future surface-cream" aria-labelledby="future-title">
    <div class="future-art" aria-hidden="true">
      <div class="fa-block"></div>
      <Img src="product-base.png" alt="" sizes="22vw" />
      <Img src="product-pouch.png" alt="" sizes="14vw" />
    </div>
    <div class="future-copy stack" style="--stack:1.25rem">
      <h2 id="future-title" class="h2" data-split>
        The Future Is Phone-Free
      </h2>
      <p>
        Our goal is to build a world where more space exists to just be. No notifications. No missed calls.
        Just presence in the moment. We aim to help people build healthier habits with their devices and
        create experiences where the magic of authenticity comes alive. In a world ruled by technology, we
        seek to bring back the human experience.
      </p>
    </div>
  </section>

  <section class="intention surface-charcoal" aria-labelledby="intention-title">
    <div class="int-bg">
      <Img src="classroom-empty.jpg" alt="" sizes="100vw" class="parallax" />
    </div>
    <div class="container int-copy">
      <h2 id="intention-title" class="h2 text-accent" data-split>
        Moving Ahead With Intention
      </h2>
      <p>
        Today, more than ever, there’s a growing desire to escape from the digital noise. With technology
        taking over almost every aspect of our lives, phone-free spaces feel like a much-needed breath of
        fresh air.
      </p>
      <p>
        At Yondr, our goal is to create a future where we can get back to the things that truly matter.
        Because there’s something spectacular that can only be found when we put down the screens and
        experience the world with our own eyes. Off we go.
      </p>
      <a href="/about" class="btn">
        Discover Yondr <Icon name="arrow-right" class="btn-icon" />
      </a>
    </div>
  </section>
</Base>

<style>
  .tl-hero {
    padding: calc(var(--header-h) + 3rem) 0 var(--section);
    overflow: hidden;
  }
  .tl-hero-grid {
    display: grid;
    gap: 3rem;
    align-items: end;
  }
  @media (min-width: 900px) {
    .tl-hero-grid {
      grid-template-columns: 1fr 1fr;
      min-height: 70svh;
    }
  }
  .tl-hero-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .tl-title {
    color: var(--forest);
    font-size: clamp(4rem, 2rem + 8vw, 10rem);
  }
  .tl-collage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr 0.55fr;
    align-items: end;
    height: clamp(22rem, 48vw, 38rem);
  }
  .tl-collage > div {
    overflow: hidden;
  }
  .tl-collage :global(picture),
  .tl-collage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .c1 {
    height: 78%;
  }
  .c2 {
    height: 92%;
  }
  .c3 {
    height: 100%;
    background: var(--lime);
  }
  @media (prefers-reduced-motion: no-preference) {
    .c1,
    .c2,
    .c3 {
      animation: rise 1.2s var(--ease-out) both;
    }
    .c2 {
      animation-delay: 0.12s;
    }
    .c3 {
      animation-delay: 0.24s;
    }
    @keyframes rise {
      from {
        transform: translateY(30%);
        opacity: 0;
      }
    }
  }

  /* Horizontal scroll timeline (desktop). Mobile falls back to a vertical list. */
  .tl {
    position: relative;
  }
  .tl-sticky {
    padding-block: var(--section);
  }
  .tl-progress {
    display: none;
  }
  .tl-track {
    list-style: none;
    padding: 0 var(--gutter);
    display: grid;
    gap: 3rem;
  }
  .tl-item {
    display: grid;
    gap: 1.25rem;
    position: relative;
  }
  .tl-img {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .tl-img :global(picture),
  .tl-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tl-history .tl-img :global(img) {
    filter: grayscale(0.85) contrast(1.05);
  }
  .tl-text {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .tl-year {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--lime);
  }
  .tl-history .tl-year {
    color: #c9ccbf;
  }
  .tl-h {
    font-family: var(--font-sans);
    font-variation-settings: normal;
    font-weight: 600;
    font-size: var(--step-1);
  }
  .tl-end .tl-h {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: var(--step-4);
    font-weight: 500;
    margin-bottom: 1rem;
  }
  .tl-text > p:not(.tl-year) {
    color: rgb(241 243 234 / 0.82);
    max-width: 36ch;
  }
  .tl-source {
    font-size: 0.8rem;
    opacity: 0.6;
  }
  @media (min-width: 900px) {
    .tl.is-pinned {
      height: var(--tl-h, 400vh);
    }
    .tl.is-pinned .tl-sticky {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
      padding-block: 0;
    }
    .tl-track {
      display: flex;
      align-items: center;
      gap: clamp(2rem, 4vw, 4rem);
      width: max-content;
      padding-inline: max(var(--gutter), (100vw - var(--max)) / 2);
      will-change: transform;
    }
    .tl:not(.is-pinned) .tl-sticky {
      overflow-x: auto;
    }
    .tl-item {
      width: 24rem;
    }
    .tl-item:nth-child(even) {
      margin-top: 8rem;
    }
    .tl-end {
      width: 28rem;
    }
    .tl-progress {
      display: block;
      position: absolute;
      left: max(var(--gutter), (100vw - var(--max)) / 2);
      right: max(var(--gutter), (100vw - var(--max)) / 2);
      bottom: 3rem;
      height: 2px;
      background: rgb(241 243 234 / 0.15);
    }
    .tl-progress span {
      position: absolute;
      inset: 0;
      background: var(--lime);
      transform-origin: left;
      transform: scaleX(var(--p, 0));
    }
  }

  .future {
    display: grid;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .future {
      grid-template-columns: 1fr 1fr;
      min-height: 34rem;
    }
  }
  .future-art {
    position: relative;
    min-height: 22rem;
  }
  .fa-block {
    position: absolute;
    inset: 40% 0 0 0;
    background: var(--lime);
  }
  .future-art :global(picture) {
    position: absolute;
  }
  .future-art :global(picture:nth-of-type(1)) {
    width: 50%;
    left: -10%;
    top: 22%;
  }
  .future-art :global(picture:nth-of-type(2)) {
    width: 30%;
    left: 44%;
    top: 8%;
    filter: drop-shadow(0 30px 30px rgb(20 24 17 / 0.3));
  }
  .future-copy {
    align-self: center;
    padding: var(--section) var(--gutter);
    max-width: 38rem;
  }
  .intention {
    position: relative;
    isolation: isolate;
    padding-block: var(--section);
    text-align: center;
    overflow: hidden;
  }
  .int-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .int-bg :global(picture),
  .int-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .int-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(12 14 10 / 0.75);
  }
  .int-copy {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    max-width: 44rem;
  }
</style>

<script>
  // Pin the timeline and translate the track horizontally as the page scrolls (desktop, motion allowed).
  const root = document.querySelector<HTMLElement>('[data-hscroll]');
  const track = root?.querySelector<HTMLElement>('[data-hscroll-track]');
  const mq = matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');
  if (root && track) {
    let distance = 0;
    const measure = () => {
      if (!mq.matches) {
        root.classList.remove('is-pinned');
        track.style.transform = '';
        return;
      }
      root.classList.add('is-pinned');
      distance = Math.max(0, track.scrollWidth - window.innerWidth);
      root.style.setProperty('--tl-h', `${distance + window.innerHeight}px`);
      update();
    };
    const update = () => {
      if (!mq.matches) return;
      const top = root.getBoundingClientRect().top;
      const p = Math.min(1, Math.max(0, -top / (root.offsetHeight - window.innerHeight || 1)));
      track.style.transform = `translate3d(${-p * distance}px,0,0)`;
      root.style.setProperty('--p', String(p));
    };
    window.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', measure);
    mq.addEventListener('change', measure);
    document.fonts.ready.then(measure);
    measure();
  }
</script>
