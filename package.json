{
  "name": "overyondr-website-v2",
  "version": "2.0.0-alpha.0",
  "description": "overyondr.com V2 — redesigned Yondr marketing site (Astro + a Cloudflare Worker with static assets)",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "postbuild": "node scripts/check-no-squarespace-cdn.mjs",
    "preview": "wrangler dev",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:links": "linkinator dist --recurse --clean-urls --skip \"^(mailto:|tel:|https?://(?!(localhost|127\\\\.0\\\\.0\\\\.1)[:/]))\"",
    "screenshots": "node scripts/walkthrough.mjs",
    "check:links:external": "linkinator dist --recurse --clean-urls --skip \"linkedin\\\\.com|ashbyhq\\\\.com|^mailto:|^tel:\"",
    "quality": "npm run quality:seo && npm run quality:redirects && npm run quality:a11y && npm run quality:lighthouse",
    "quality:seo": "node scripts/quality/seo.mjs",
    "quality:redirects": "node scripts/quality/redirects.mjs",
    "quality:a11y": "node scripts/quality/a11y.mjs",
    "quality:lighthouse": "lhci collect && lhci upload && lhci assert"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@lhci/cli": "^0.16.1",
    "linkinator": "^8.1.0",
    "playwright": "~1.63.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
